# Copy this file to .env and fill in real values. Never commit .env to source control.

# ---- MySQL Database ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=Deep@123
DB_NAME=predictive_maintenance

# ---- App ----
MOTOR_ID=MOTOR-001
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# Optional shared secret the microcontroller must send as header
# X-Device-Api-Key when POSTing to /api/sensors/data. Leave blank to disable.
DEVICE_API_KEY=

# Whether Demo Mode is ON by default on first startup (true/false).
# Can be toggled later at runtime via POST /api/settings/demo-mode.
DEMO_MODE_DEFAULT=true
